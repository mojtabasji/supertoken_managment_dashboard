# SuperTokens Admin Portal — environment configuration
# Copy to .env.local (or your deployment's env store) and fill in real values.
# Never commit real credentials.

# ---------------------------- Required ----------------------------

# URL of your self-hosted SuperTokens Core.
# There is intentionally no default: the portal fails to start if this is missing.
SUPERTOKENS_CONNECTION_URI=https://core.example.com:3567

# API key configured on the SuperTokens Core (`apiKeys` config).
# Leave empty only if your Core runs without API keys (not recommended).
SUPERTOKENS_API_KEY=replace-with-core-api-key

# Comma-separated allowlist of administrator email addresses allowed to sign in.
# Only these identities can obtain an admin session, regardless of password knowledge.
ADMIN_EMAILS=admin@example.com,another-admin@example.com

# Shared administrator sign-in password. Minimum 12 characters.
# Use a strong, unique value stored in your secret manager — not this example.
ADMIN_PASSWORD=change-me-strong-password

# Secret used to HMAC-sign admin session cookies. Minimum 32 characters of entropy,
# e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-at-least-32-char-random-secret

# Canonical public URL of this admin application.
# Used for the server-side Origin check on state-changing requests and cookie flags.
APP_BASE_URL=http://localhost:3000

# ---------------------------- Optional ----------------------------

# Path to the SQLite database file used for the audit log.
# Default: data/audit.db (created on first write).
# AUDIT_DB_PATH=data/audit.db
